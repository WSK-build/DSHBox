<?xml version="1.0" encoding="utf-8"?>
<!--
  通用描边图标（Tabler outline `folder-open`）。
  与底部导航那五个同源同规格：24×24、stroke 2、圆角端与圆角连接；
  pathData 逐字取自源 SVG，不做坐标换算。
  描边色占位为黑，显示颜色一律由调用处的 Icon(tint = …) 决定 ——
  因此深浅主题各自跟随，无硬编码颜色。

  归属：common 模块（app 与 plugin-manager 都依赖它），一处定义、两处引用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M5 19l2.757 -7.351a1 1 0 0 1 .936 -.649h12.307a1 1 0 0 1 .986 1.164l-.996 5.211a2 2 0 0 1 -1.964 1.625h-14.026a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v2"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>

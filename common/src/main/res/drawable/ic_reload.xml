<?xml version="1.0" encoding="utf-8"?>
<!--
  通用描边图标（Tabler outline `reload`：圆弧 + 单箭头）。
  与底部导航那五个同源同规格：24×24、stroke 2、圆角端与圆角连接；
  pathData 逐字取自源 SVG，不做坐标换算。
  描边色占位为黑，显示颜色一律由调用处的 Icon(tint = …) 决定 ——
  因此深浅主题各自跟随，无硬编码颜色。

  归属：common 模块（与其他通用描边图标同处定义），一处定义、多处引用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M19.933 13.041a8 8 0 1 1 -9.925 -8.788c3.899 -1 7.935 1.007 9.425 4.747"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M20 4v5h-5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>

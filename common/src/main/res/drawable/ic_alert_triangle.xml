<?xml version="1.0" encoding="utf-8"?>
<!--
  通用描边图标（Tabler outline `alert-triangle`）。
  与底部导航那五个同源同规格：24×24、stroke 2、圆角端与圆角连接；
  pathData 逐字取自源 SVG，不做坐标换算。
  描边色占位为黑，显示颜色一律由调用处的 Icon(tint = …) 决定 ——
  因此深浅主题各自跟随，无硬编码颜色。

  归属：common 模块（app 与 plugin-manager 都依赖它），一处定义、两处引用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12 9v4"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M12 16h.01"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>

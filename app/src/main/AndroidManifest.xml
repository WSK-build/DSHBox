<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission android:name="${applicationId}.permission.BROWSER_INTERNAL"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.BROWSER_INTERNAL" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- DSH Web 侧能力的运行时权限：语音输入需要录音，附件来源菜单的「拍照/录像」
         需要相机。两者都在使用时按需请求，未授予时只有对应功能不可用。
         注意：本应用一旦声明 CAMERA，系统会要求 ACTION_IMAGE_CAPTURE 调用方持有
         该权限，因此相机入口必须先确保权限已授予再发起拍摄。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 普通权限（安装即授，无运行时弹窗）。Chromium 的录音设备检查要求它与
         RECORD_AUDIO **同时**具备，否则 WebView 内拿不到录音设备：
         日志表现为 `Requires MODIFY_AUDIO_SETTINGS and RECORD_AUDIO. No audio
         device will be available for recording`，页面侧则表现为语音输入启动失败。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 共享区（公共存储 DSHBox 目录，与 guest /root/share/DSHBox 同一份数据）。
         Android 11+ 读写公共存储需要「所有文件访问」特殊权限（在设置页授予）；
         Android 10 走旧式存储（requestLegacyExternalStorage + WRITE_EXTERNAL_STORAGE）。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- 无摄像头/麦克风的设备仍可安装：声明为非必需，避免被装机过滤 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- targetSdk 30+ 包可见性——外部打开/编辑/分享的目标应用查询签名 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".DshApp"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/brand_icon"
        android:roundIcon="@mipmap/brand_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.DSHapp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 外部应用「分享到」入口：任意类型，收下后由用户在文件页选定落点目录。
                 通配类型同时覆盖 text/plain（分享文字/链接会落盘为 .txt）。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 外部应用「用其他应用打开」入口：内容提供器的文件 URI。
                 两种形态都要覆盖，故声明两个过滤器——带类型（绝大多数应用）与不带类型
                 （部分自建提供器不给 getType）：平台规则是"只声明 URI 的过滤器只匹配
                 不带类型的意图"，反之亦然，缺一个都会漏掉一整类来源。
                 有意不声明 http/https——否则点任何网页链接都会弹出本应用。
                 本应用自身会被解析到，故对外打开/分享的选择器统一排除自身组件。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SandboxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DSH sandbox container" />
        </service>

        <!-- appcompat 应用内语言持久化（API<33 生效；API 33+ 走系统
             LocaleManager）。autoStoreLocales=true 时进程启动自动恢复上次所选语言。 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <!-- DevInstallReceiver（DEBUG 构建专用安装广播）移入
             src/debug/AndroidManifest.xml——release 不再注册该接收器，
             消除 exported 外部触发面。 -->

        <!-- 外部应用调用（VIEW/EDIT/SEND）的 content URI 支持，
             四根精确 files-path 见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.dshbox.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

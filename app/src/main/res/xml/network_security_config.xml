<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- 127.0.0.2~127.0.0.11 是远程连接模块的设备会话槽位回环池：每台远程设备绑定
         一个槽位 IP，其端点会话经本地回环代理在该 IP 上呈现，明文白名单随池开放。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.2</domain>
        <domain includeSubdomains="false">127.0.0.3</domain>
        <domain includeSubdomains="false">127.0.0.4</domain>
        <domain includeSubdomains="false">127.0.0.5</domain>
        <domain includeSubdomains="false">127.0.0.6</domain>
        <domain includeSubdomains="false">127.0.0.7</domain>
        <domain includeSubdomains="false">127.0.0.8</domain>
        <domain includeSubdomains="false">127.0.0.9</domain>
        <domain includeSubdomains="false">127.0.0.10</domain>
        <domain includeSubdomains="false">127.0.0.11</domain>
    </domain-config>
</network-security-config>

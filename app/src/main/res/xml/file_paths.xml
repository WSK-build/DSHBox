<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 四个物理根各声明精确 files-path（最小授权，不暴露整个 filesDir）。
     legacy debian 单层根（旧安装回退）不在授权范围：该形态下外部打开返回空后自动降级导出。 -->
<paths>
    <files-path
        name="base_layer"
        path="runtime/runtime-current/base/" />
    <files-path
        name="node_layer"
        path="runtime/runtime-current/node/" />
    <files-path
        name="dsh_layer"
        path="runtime/runtime-current/dsh/" />
    <files-path
        name="user_data"
        path="user-data/" />
    <!-- 「拍照 / 录像」的输出暂存（cacheDir 之下）：相机应用需要一个可写的 content URI
         作为 EXTRA_OUTPUT，拍完由本应用读回并作为附件上传。
         必须与 DshWebViewScreen.CAPTURE_DIR_NAME 保持一致。 -->
    <cache-path
        name="camera_capture"
        path="camera-capture/" />
    <!-- 共享区：Android 公共存储的 DSHBox 目录（与 guest /root/share/DSHBox 同一份数据），
         供共享区内的「拍照 / 录像」落点与「分享 / 外部打开」出口使用。 -->
    <external-path
        name="share_area"
        path="DSHBox/" />
    <!-- 用户挂载目录位于公共存储任意位置，无法逐个声明：补一条公共存储根。
         Provider 不导出，仅经用户显式操作（拍摄落点 / 分享）逐 URI 授权。 -->
    <external-path
        name="share_mounts"
        path="." />
</paths>

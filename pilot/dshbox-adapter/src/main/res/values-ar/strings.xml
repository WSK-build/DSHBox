    <string name="pilot_action_vendor_autostart">فتح إعدادات التشغيل التلقائي والعمل في الخلفية لدى الشركة المصنّعة</string>
    <string name="pilot_action_open_app_details">فتح هذا التطبيق في إعدادات النظام</string>
    <string name="pilot_action_understood">فهمت</string>
